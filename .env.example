# Copy to .env (keep this file!) and fill in. .env is git-ignored - never commit real values.

# --- Web (eSuite) ---
ESUITE_BASE_URL=https://esuite.edot.id
ESUITE_EMAIL=
ESUITE_PASSWORD=
# A saved login younger than this (minutes) is reused by local reruns instead of logging in again.
AUTH_MAX_AGE_MIN=30

# --- AI (optional) ---
# Leave empty to run fully offline: test data falls back to Faker, triage uses rules only.
ANTHROPIC_API_KEY=
AI_DATA_MODEL=claude-haiku-4-5
AI_TRIAGE_MODEL=claude-sonnet-5-5

# --- Mobile (eWork SFA) ---
# The salesman used for login/customer tests (the fallback account given in the brief).
EWORK_COMPANY_ID=
EWORK_USERNAME=
EWORK_PASSWORD=
# Full path on Windows, e.g. E:\Tools\maestro\bin\maestro.bat
MAESTRO_BIN=maestro

# --- Optional ---
# Fix the run tag to reproduce a run's generated data exactly (Faker path), e.g. RUN_ID=C95EA1
RUN_ID=
# Deliberate breakage for the triage demo only: missing_locator | wrong_element
QA_BREAK=
